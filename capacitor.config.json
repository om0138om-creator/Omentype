{
  "appId": "com.fontstudio.pro",
  "appName": "فونت ستوديو برو",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#1a1a2e",
      "showSpinner": true,
      "spinnerColor": "#667eea"
    },
    "Filesystem": {
      "directory": "Documents"
    },
    "Permissions": {
      "permissions": ["storage", "camera", "photos"]
    }
  },
  "android": {
    "buildOptions": {
      "keystorePath": null,
      "keystoreAlias": null
    },
    "minSdkVersion": 23,
    "targetSdkVersion": 34,
    "permissions": [
      "android.permission.READ_EXTERNAL_STORAGE",
      "android.permission.WRITE_EXTERNAL_STORAGE",
      "android.permission.READ_MEDIA_IMAGES",
      "android.permission.CAMERA",
      "android.permission.INTERNET"
    ]
  }
}
